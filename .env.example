# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Lựa chọn LLM Provider: "gemini", "openai", "anthropic", "openrouter", hoặc "mock" (offline)
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
# URL tùy chỉnh cho Gemini-compatible API gateway (để trống dùng endpoint mặc định)
GEMINI_BASE_URL=

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini
# URL tùy chỉnh cho OpenAI-compatible API gateway (để trống dùng endpoint mặc định)
OPENAI_BASE_URL=

# URL dùng chung khi provider-specific Base URL không được cấu hình
API_BASE_URL=

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-haiku-20241022

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
